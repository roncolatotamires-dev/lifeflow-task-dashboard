# Vercel Environment Variables Configuration

# 1. Backend Variables (Vercel Serverless Function)
PORT=5000
JWT_SECRET=sua_chave_secreta_jwt_para_producao_aqui
DB_PATH=/tmp/database.sqlite

# 2. Frontend Variables (Vite React Client)
# Deixe em branco se a API e Frontend estiverem no mesmo domínio na Vercel (/api)
VITE_API_URL=/api
